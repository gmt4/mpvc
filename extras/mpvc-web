mpvc_web_mkcert()
{
    MPVC_WEB_BASE="$MPVC_WEB_ROOT/.."
    MPVC_WEB_SSL_SUBJ="/C=CN/ST=ST/O=MPVC-LAN-NET/CN=mpvc-server-ca-$MPVC_WEB_HOSTNAME"
    SAN_STR="DNS:$MPVC_WEB_HOSTNAME, IP:127.0.0.1"
    CLEAN_IPS=$(ifconfig | awk '/inet / {print $2}' | grep -v -E '^(127\.0\.0\.1|172\.(1[6-9]|2[0-9]|3[0-1])\.)')
    for ip in $CLEAN_IPS; do [ -z "$ip" ] && continue; SAN_STR="$SAN_STR, IP:$ip"; done

    # Create temporary OpenSSL config to inject true CA attributes
    CONF_FILE="$MPVC_WEB_BASE/openssl_ca.cnf"
    cat <<EOF > "$CONF_FILE"
[ req ]
distinguished_name = req_distinguished_name
x509_extensions     = v3_ca

[ req_distinguished_name ]

[ v3_ca ]
subjectKeyIdentifier   = hash
authorityKeyIdentifier = keyid:always,issuer
basicConstraints       = critical, CA:true
keyUsage               = critical, digitalSignature, cRLSign, keyCertSign
subjectAltName         = $SAN_STR
EOF

    # Set Server CA validity to 3650 days (10 years)
    openssl req -new -x509 -days 3650 -nodes -config "$CONF_FILE" -out "$MPVC_WEB_SSL_PEM" -keyout "$MPVC_WEB_SSL_PEM" -subj "$MPVC_WEB_SSL_SUBJ"
    # Generate temporary Client Key and CSR
    openssl req -nodes -newkey rsa:2048 -keyout "$MPVC_WEB_BASE/client.key" -out "$MPVC_WEB_BASE/client.csr" -subj "/CN=mpvc-lan-client"
    # Generate Client Certificate
    openssl x509 -req -in "$MPVC_WEB_BASE/client.csr" -CA "$MPVC_WEB_SSL_PEM" -CAkey "$MPVC_WEB_SSL_PEM" -CAcreateserial -out "$MPVC_WEB_BASE/client.crt" -days 3650
    # Export p12 Client Bundle to Webroot (For Client Device Identity)
    openssl pkcs12 -export -legacy -passout "pass:" -inkey "$MPVC_WEB_BASE/client.key" -in "$MPVC_WEB_BASE/client.crt" -name "mpvc-client-$MPVC_WEB_HOSTNAME" -out "$MPVC_WEB_ROOT/client.p12"
    # Export ONLY the public Server CA certificate (For Browser Trust Store)
    openssl x509 -in "$MPVC_WEB_SSL_PEM" -out "$MPVC_WEB_ROOT/server.crt"
    # Purge all temporary assets safely
    rm -f "$MPVC_WEB_BASE/client.key" "$MPVC_WEB_BASE/client.csr" "$MPVC_WEB_BASE/client.crt" "$CONF_FILE"
}

mpvc_web_https()
{
    MPVC_WEB_LISTEN="bind=$MPVC_WEB_HOST,cert=$MPVC_WEB_SSL_PEM,cafile=$MPVC_WEB_SSL_PEM,verify=$MPVC_WEB_SSL_VERIFY"
    MPVC_WEB_TCP=$([ "$MPVC_WEB_HOST" != "0" ] && echo "$MPVC_WEB_HOST" || echo "localhost")

    socat "OPENSSL-LISTEN:$MPVC_WEB_SSL_PORT,$MPVC_WEB_LISTEN,reuseaddr,fork" "TCP:$MPVC_WEB_TCP:$MPVC_WEB_PORT" &
    #echo "$$" > "$MPVC_WEB_SSL_PID"
}

mpvc_web_qrcode()
{
    host=$MPVC_WEB_HOST
    if ! command -v qrencode >/dev/null; then return; fi

    if [ "$host" = "0" ]; then
        if command -v ip >/dev/null 2>&1; then
            host=$(ip route get 1.1.1.1 | awk '/src/ {for(i=1;i<=NF;i++) if($i=="src") print $(i+1)}')
        else
            host=$(ifconfig "$(route -n get 1.1.1.1 | awk '/interface:/ {print $2}')" | awk '/inet / {print $2}')
        fi
    fi

    qrurl="http://$host:$MPVC_WEB_PORT";
    if [ -n "${MPVC_WEB_SSL_ENABLE}" ]; then
        qrurl="https://$host:$MPVC_WEB_SSL_PORT";
    fi

    if command -v qrencode >/dev/null; then
        echo "# $PROGNAME Client QR code $qrurl"
        echo
        qrencode -s 6 -l H -t ansiutf8 "$qrurl";
        echo
    fi
}

mpvc_web_setup()
{
    mpvc_web_config
    echo "# $PROGNAME $PROGVERSION running (beta version: might contain bugs!) SSL=${MPVC_WEB_SSL_ENABLE}"

    (
        # setup http webroot
        echo "# $PROGNAME Setup $MPVC_WEB_ROOT"
        mkdir -p "${MPVC_WEB_ROOT%/*}"
        mkdir -p "$MPVC_WEB_ROOT" && chmod 700 "$MPVC_WEB_ROOT" || return
        mkdir -p "$MPVC_WEB_CGI_DIR" && chmod 700 "$MPVC_WEB_CGI_DIR" || return

        cd "$MPVC_WEB_ROOT" || return
        chmod -R u+w "${MPVC_WEB_ROOT%/*}"
        umask 0077

        # setup streamable mpvc archive if requested
        if [ -n "${MPVC_WEB_ARCHIVE_ENABLE}" ]; then
            echo "# $PROGNAME Setup $MPVC_WEB_ROOT/ytdl-archive/"
            ln -f -s "$HOME/.config/mpvc/ytdl-archive/" "$MPVC_WEB_ROOT/"
        fi

        mpvc_web_index > "$MPVC_WEB_ROOT/index.html"
        echo > "$MPVC_WEB_ROOT/favicon.ico"
        mpvc_web_serviceworker > "$MPVC_WEB_ROOT/sw.js"
        mpvc_web_manifest > "$MPVC_WEB_ROOT/manifest.json"
        mpvc_web_icon_svg > "$MPVC_WEB_ROOT/apple-touch-icon.svg"
        # Setup apple-touch-icon.png for manifest.json
        if [ ! -e "$MPVC_WEB_ROOT/apple-touch-icon.png" ]; then
            convert -background none -density 300 "$MPVC_WEB_ROOT/apple-touch-icon.svg" -resize 192x192 "$MPVC_WEB_ROOT/apple-touch-icon.png"
            convert -background none -density 300 "$MPVC_WEB_ROOT/apple-touch-icon.svg" -resize 512x512 "$MPVC_WEB_ROOT/apple-touch-icon-maskable.png"
        fi

        if [ -n "$MPVC_WEB_CSS_STYLE" ]; then
            cat "$MPVC_WEB_CSS_STYLE" > "$MPVC_WEB_ROOT/style.css"
        fi

        ln -s -f "$PROGDIR/mpvc-web-video" "$MPVC_WEB_CGI_DIR"
        ln -s -f "$PROGDIR/mpvc-web-browser" "$MPVC_WEB_CGI_DIR"

        # setup https socat if requested
        if [ -n "${MPVC_WEB_SSL_ENABLE}" ]; then
            echo "# $PROGNAME Setup $MPVC_WEB_ROOT socat: $MPVC_WEB_HOST:$MPVC_WEB_SSL_PORT"
            if [ ! -e "$MPVC_WEB_SSL_PEM" ]; then
                mpvc_web_mkcert "$MPVC_WEB_SSL_PEM"
            fi
            if [ -s "$MPVC_WEB_SSL_PID" ]; then
                kill "$(cat "$MPVC_WEB_SSL_PID")" || true
            fi
            mpvc_web_https

        fi

        mpvc_web_qrcode

        if [ -n "${MPVC_WEB_EXTRAS_URL:-}" ]; then
            echo "# $PROGNAME Setup extras/url features (MPVC_WEB_EXTRAS_URL=$MPVC_WEB_EXTRAS_URL is set)"
        fi

        # setup http requested
        echo "# $PROGNAME Setup http://$MPVC_WEB_HOST:$MPVC_WEB_PORT"

        chmod -R a-w "$MPVC_WEB_ROOT/"
    )
}

mpvc_web_envclean()
{
    MPVC=$(command -v mpvc)
    env -i PATH=/usr/local/bin:/usr/bin:/bin HOME="$HOME" TERM="$TERM" MPVC="$MPVC" "$@"
}

mpvc_web()
{
    mpvc_web_setup
    (
        cd "$MPVC_WEB_ROOT" || return

        # rework this to unify in a single: mpvcbin + cgi-bin
        mpvc_web_envclean python3 -u -m http.server --cgi --bind "$MPVC_WEB_HOST" "$MPVC_WEB_PORT" "$@" 2>&1 |
            #mawk -W interactive -v mpvcbin="$MPVC"
            mpvc_web_envclean awk -v mpvcbin="$MPVC" \
        '
        function mpvcsys(cmd) { system(mpvcbin" "cmd); }
        function mpvc(cmd)    { mpvcsys("mpvc -q "cmd); }

        BEGIN {
            system("env")
            allowCmdStr = "mpv clear kill mute toggle play start stop prev next playrand shuffle unshuffle repeat single replay togglev aspect togglew togglef togglei creplay cloop cprev cnext cplayrand cycle-volume"
            n = split(allowCmdStr, a, /[[:space:]]+/)
            for (i = 1; i <= n; i++) { allowCmdList[a[i]] = 1; }
        }

        $0 ~ /"GET \/\?cmd=mpvc%20/ {
            cmd="";

            if (match($0, /"GET \/\?cmd=mpvc%20[-a-z]+/))
            {
                n=length("\"GET /?cmd=mpvc%20")
                cmd=substr($0, RSTART+n, RLENGTH-n)
            }

            if (cmd in allowCmdList)
            {
                mpvc(cmd)
            }
        }

        { print $0 }
        '
    )
}

optflags="ha:b:c:d:p:P:r:R:s:S:t:T:x:"
usage()
{
    cat <<EOF
usage: $PROGNAME -[$optflags] args # @version $PROGVERSION (c) $PROGAUTHOR $PROGURL
  -c : Set $PROGNAME HTTP server command: [start,stop] (*required)
  -b : Set $PROGNAME HTTP server bind address (default $MPVC_WEB_HOST)
  -p : Set $PROGNAME HTTP server port (default $MPVC_WEB_PORT)
  -r : Set $PROGNAME HTTP server root dir (default $MPVC_WEB_ROOT)
  -R : Set $PROGNAME HTTP server HTML refresh (default $MPVC_WEB_HTML_REFRESH)
  -s : Set $PROGNAME HTTP server SSL/TLS (default $MPVC_WEB_SSL_ENABLE)
  -a : Set $PROGNAME HTTP server to include ytdl-archive/ (default $MPVC_WEB_ARCHIVE_ENABLE)
*tips: If unsure where to begin, run: $PROGNAME -p $MPVC_WEB_PORT -c start # serves @ http://localhost:$MPVC_WEB_PORT
EOF
    exit
}

main()
{
    [ $# -lt 0 ] && usage

    mpvc_web_defaults

    while getopts "$optflags" flag;
    do
        case "$flag" in
        h) usage ;;
        c) MPVC_WEB_CMD="$OPTARG"; ;;
        x) MPVC_WEB_EXTRAS_URL="${MPVC_WEB_EXTRAS_URL} $OPTARG"; ;;
        b) MPVC_WEB_HOST="$OPTARG" ;;
        p) MPVC_WEB_PORT="$OPTARG" ;;
        P) MPVC_WEB_SSL_PORT="$OPTARG" ;;
        r) MPVC_WEB_ROOT="$OPTARG" ;;
        R) MPVC_WEB_HTML_REFRESH="$OPTARG" ;;
        s) MPVC_WEB_SSL_ENABLE="$OPTARG" ;;
        S) MPVC_WEB_SSL_PEM="$OPTARG" ;;
        t) MPVC_WEB_HTML_THEME="$OPTARG"  ;;
        T) MPVC_WEB_CSS_STYLE="$OPTARG"  ;;
        a) MPVC_WEB_ARCHIVE_ENABLE="$OPTARG" ;;
        *) usage ;;
        esac
    done
    shift $((OPTIND - 1))

    case "${MPVC_WEB_CMD:-}" in
    status) ps auxww | grep "$PROGNAME" ;;
    start)  mpvc_web "$@";;
    stop)   pkill -f "$PROGNAME" ;;
    *)      usage ;;
    esac
}

main "$@"
